# Optional for LOCAL development. Without DB_URL, the app uses a local H2 database.
# For the cloud, fill in these three values in Render/Railway Environment Variables.
# Copy the host, username and port from Supabase > Connect > Session pooler.
# DB_URL=jdbc:postgresql://YOUR-SESSION-POOLER-HOST:5432/postgres?sslmode=require
# DB_USER=postgres.YOUR_PROJECT_REF
# DB_PASSWORD=YOUR_DATABASE_PASSWORD
# Never commit a file containing your actual password.
